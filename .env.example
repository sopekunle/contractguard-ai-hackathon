# Firebase Console -> Project settings -> Your apps -> ContractGuard AI -> Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Production only: reCAPTCHA Enterprise site key for Firebase App Check.
# Leave empty for local development. Never put a debug token here.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local App Check debugging. Leave these unset normally.
# Loopback works with the flag alone. LAN also requires trusted HTTPS and exact private IPv4 literals.
VITE_ENABLE_APP_CHECK_DEBUG=
VITE_APP_CHECK_DEBUG_LAN_HOSTS=

# Optional HTTPS certificate and private key file paths for the Vite dev server.
# Keep both files outside the repo. These settings take file paths, never token values.
CONTRACTGUARD_DEV_TLS_CERT=
CONTRACTGUARD_DEV_TLS_KEY=
